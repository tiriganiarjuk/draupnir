{
  "title": "Array",
  "type": "object",
  "description": "Variable-length array of simplegroup items.\n\nItems is either a single simplegroup ref (string) or a oneOf\ncomposition ({oneOf: [...]}). Pydantic union matching handles both:\nstring → SimplegroupRef, dict → ArrayOneOf.",
  "$defs": {
    "ArrayOneOf": {
      "title": "ArrayOneOf",
      "type": "object",
      "description": "OneOf composition for array items — multiple simplegroup options.",
      "properties": {
        "oneOf": {
          "title": "Oneof",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SimplegroupRef"
          }
        },
        "description": {
          "title": "Description",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "oneOf"
      ]
    },
    "Atom": {
      "type": "string"
    },
    "AtomOrEnumRef": {
      "type": "string"
    },
    "ConditionalWhen": {
      "title": "ConditionalWhen",
      "type": "object",
      "description": "Predicate controlling conditional field presence.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "equals": {
          "title": "Equals",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in": {
          "title": "In",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exists": {
          "const": true
        }
      },
      "required": [
        "field"
      ],
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "exists"
          ]
        }
      ]
    },
    "ConstraintRule": {
      "title": "ConstraintRule",
      "type": "object",
      "description": "Cross-field validation rule carried by a field.",
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "title": "Order",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in": {
          "title": "In",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rule",
        "severity",
        "reason"
      ]
    },
    "Element": {
      "type": "string"
    },
    "Enum": {
      "type": "string"
    },
    "FieldItemRef": {
      "type": "string"
    },
    "FieldRef": {
      "type": "string"
    },
    "FieldTypeRef": {
      "type": "string"
    },
    "Pattern": {
      "type": "string"
    },
    "PatternRef": {
      "type": "string"
    },
    "SemanticBlock": {
      "title": "SemanticBlock",
      "type": "object",
      "description": "Semantic intent and validation guidance for a field.",
      "properties": {
        "intent": {
          "title": "Intent",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checks": {
          "title": "Checks",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anti_patterns": {
          "title": "Anti Patterns",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "title": "Severity",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "Simplearray": {
      "type": "string"
    },
    "SimplegroupConditionalEntry": {
      "title": "SimplegroupConditionalEntry",
      "type": "object",
      "description": "Conditional field entry for simplegroup zones.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/SimplegroupItemRef"
        },
        "only_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionalWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "always_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionalWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionalWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ref"
      ],
      "oneOf": [
        {
          "required": [
            "only_when"
          ]
        },
        {
          "required": [
            "always_when"
          ]
        },
        {
          "required": [
            "not_when"
          ]
        }
      ]
    },
    "SimplegroupItemRef": {
      "type": "string"
    },
    "SimplegroupRef": {
      "type": "string"
    },
    "Tuple_": {
      "type": "string"
    },
    "UnionMemberRef": {
      "type": "string"
    },
    "Union_": {
      "type": "string"
    },
    "VerdandiField": {
      "type": "string"
    }
  },
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "items": {
