          "$ref": "#/$defs/ArrayOneOf"
        }
      ]
    },
    "min_items": {
      "title": "Min Items",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "max_items": {
      "title": "Max Items",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unique_items": {
      "title": "Unique Items",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "title",
    "items",
    "description"
  ]
}
