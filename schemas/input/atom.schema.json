    },
    "excludes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/PatternRef"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excludes"
    },
    "min_length": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
