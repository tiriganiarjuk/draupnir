    },
    "max_length": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Length"
    },
    "description": {
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "description"
  ],
  "title": "Atom",
  "type": "object"
}
