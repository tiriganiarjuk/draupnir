{
  "title": "Simplearray",
  "type": "object",
  "description": "Variable-length array of a single field type.",
  "$defs": {
    "Atom": {
      "type": "string"
    },
    "AtomOrEnumRef": {
      "type": "string"
    },
    "ConstraintRule": {
      "title": "ConstraintRule",
      "type": "object",
      "description": "Cross-field validation rule carried by a field.",
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "title": "Order",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in": {
          "title": "In",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rule",
        "severity",
        "reason"
      ]
    },
    "Element": {
      "type": "string"
    },
    "Enum": {
      "type": "string"
    },
    "FieldItemRef": {
      "type": "string"
    },
    "FieldRef": {
      "type": "string"
    },
    "FieldTypeRef": {
      "type": "string"
    },
    "Pattern": {
      "type": "string"
    },
    "PatternRef": {
      "type": "string"
    },
    "SemanticBlock": {
      "title": "SemanticBlock",
      "type": "object",
      "description": "Semantic intent and validation guidance for a field.",
      "properties": {
        "intent": {
          "title": "Intent",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checks": {
          "title": "Checks",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anti_patterns": {
          "title": "Anti Patterns",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "title": "Severity",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "Tuple_": {
      "type": "string"
    },
    "UnionMemberRef": {
      "type": "string"
    },
    "Union_": {
      "type": "string"
    }
  },
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "items": {
      "$ref": "#/$defs/FieldItemRef"
    },
    "min_items": {
      "title": "Min Items",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "max_items": {
      "title": "Max Items",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unique_items": {
      "title": "Unique Items",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "title",
    "items",
    "description"
  ]
}
