{
  "title": "Simplegroup",
  "type": "object",
  "description": "Flat object with field zones — no nested containers.",
  "$defs": {
    "Atom": {
      "type": "string",
      "pattern": "^(atom)/[a-z0-9][a-z0-9_-]*$"
    },
    "AtomOrEnumRef": {
      "type": "string",
      "pattern": "^(enum|atom)/[a-z0-9][a-z0-9_-]*$"
    },
    "ConditionalWhen": {
      "title": "ConditionalWhen",
      "type": "object",
      "description": "Predicate controlling conditional field presence.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "equals": {
          "title": "Equals",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in": {
          "title": "In",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exists": {
          "const": true
        }
      },
      "required": [
        "field"
      ],
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "exists"
          ]
        }
      ],
      "additionalProperties": false
    },
    "ConstraintRule": {
      "title": "ConstraintRule",
      "type": "object",
      "description": "Cross-field validation rule carried by a field.",
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "title": "Order",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in": {
          "title": "In",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rule",
        "severity",
        "reason"
      ],
      "additionalProperties": false
    },
    "Element": {
      "type": "string",
      "pattern": "^(element)/[a-z0-9][a-z0-9_-]*$"
    },
    "Enum": {
      "type": "string",
      "pattern": "^(enum)/[a-z0-9][a-z0-9_-]*$"
    },
    "FieldItemRef": {
      "type": "string",
      "pattern": "^(field)/[a-z0-9][a-z0-9_-]*$"
    },
    "FieldRef": {
      "type": "string",
      "pattern": "^(pattern|enum|atom|element|tuple|union)/[a-z0-9][a-z0-9_-]*$"
    },
    "FieldTypeRef": {
      "type": "string",
      "pattern": "^(enum|atom|element|tuple|union)/[a-z0-9][a-z0-9_-]*$"
    },
    "Pattern": {
      "type": "string",
      "pattern": "^(pattern)/[a-z0-9][a-z0-9_-]*$"
    },
    "PatternRef": {
      "type": "string",
      "pattern": "^(pattern)/[a-z0-9][a-z0-9_-]*$"
    },
    "SemanticBlock": {
      "title": "SemanticBlock",
      "type": "object",
      "description": "Semantic intent and validation guidance for a field.",
      "properties": {
        "intent": {
          "title": "Intent",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checks": {
          "title": "Checks",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anti_patterns": {
          "title": "Anti Patterns",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "title": "Severity",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Simplearray": {
      "type": "string",
      "pattern": "^(simplearray)/[a-z0-9][a-z0-9_-]*$"
    },
    "SimplegroupConditionalEntry": {
      "title": "SimplegroupConditionalEntry",
      "type": "object",
      "description": "Conditional field entry for simplegroup zones.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/SimplegroupItemRef"
        },
        "only_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionalWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "always_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionalWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionalWhen"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "ref"
      ],
      "oneOf": [
        {
          "required": [
            "only_when"
          ]
        },
        {
          "required": [
            "always_when"
          ]
        },
        {
          "required": [
            "not_when"
          ]
        }
      ],
      "additionalProperties": false
    },
    "SimplegroupItemRef": {
      "type": "string",
      "pattern": "^(field|simplearray)/[a-z0-9][a-z0-9_-]*$"
    },
    "Tuple_": {
      "type": "string",
      "pattern": "^(tuple)/[a-z0-9][a-z0-9_-]*$"
    },
    "UnionMemberRef": {
      "type": "string",
      "pattern": "^(enum|atom|element|tuple)/[a-z0-9][a-z0-9_-]*$"
    },
    "Union_": {
      "type": "string",
      "pattern": "^(union)/[a-z0-9][a-z0-9_-]*$"
    },
    "VerdandiField": {
      "type": "string",
      "pattern": "^(field)/[a-z0-9][a-z0-9_-]*$"
    }
  },
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "required": {
      "title": "Required",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SimplegroupItemRef"
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "optional": {
      "title": "Optional",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SimplegroupItemRef"
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "conditional": {
      "title": "Conditional",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SimplegroupConditionalEntry"
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "title",
    "description"
  ],
  "additionalProperties": false,
  "minProperties": 3,
  "$comment": "At least one of required, optional or conditional: the object is closed and its only keys are title and description (both required) and its three zones, so three keys or more means at least one zone. Adding a key to this level changes the count."
}
